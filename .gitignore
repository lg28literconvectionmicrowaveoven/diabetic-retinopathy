# Python / Environment
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
env/
venv/
.python-version
.pytest_cache/
.DS_Store

# Datasets (Keep data directory ignored to prevent large binary bloat)
data/
*.zip
*.tar.gz
*.tar

# Large Embeddings and Raw Outputs (Track checkpoints and metrics only)
outputs/embeddings/
outputs/logs/
outputs/idrid_results/*.npy
outputs/predictions/**/*.npz

# Allow trained fold weights and evaluation metrics
!outputs/checkpoints/**/best.pt
!outputs/metrics/*.json
!outputs/metrics/*.csv

# Node / SvelteKit Frontend
frontend/node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/.env.local
# Generated verification outputs
results/gui_verification/